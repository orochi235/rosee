{
  "name": "rosee-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @rosee/lab",
    "build": "npm run build -w rosee && npm run build -w @rosee/lab",
    "pretest": "playwright install chromium-headless-shell",
    "test": "vitest run",
    "smoke": "npm run smoke -w @rosee/lab",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vitest": "^5.0.1"
  }
}
